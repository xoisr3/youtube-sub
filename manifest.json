{
  "manifest_version": 3,
  "name": "YouTube Subtitles & Lyrics Side Panel",
  "version": "1.0.0",
  "description": "Displays synchronized YouTube subtitles & lyrics in Chrome Side Panel with real-time voice highlighting and interactive seeking.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Subtitles Side Panel"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/content-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content/content-isolated.js"],
      "run_at": "document_idle"
    }
  ]
}
